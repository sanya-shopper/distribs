@misc{shastats2026,
  author       = {{The \texttt{shastats} project}},
  title        = {shastats: Leading-Zero Statistics of {SHA}-256},
  year         = {2026},
  howpublished = {Sibling repository on this paper's authoring machine;
                  no public remote as of 2026-08-09},
  note         = {Local copy: \texttt{../\_refs/distribs/shastats-2026.pdf}, a PDF
                  snapshot of the repository's README and working notes
                  taken 2026-08-09 (\texttt{make fetch-refs} regenerates
                  it when the sibling checkout, directory
                  \texttt{../256-shastats}, sits beside this
                  repository).  Hashes $8{,}623{,}489{,}024$ 256-bit
                  messages to ask whether a prefixed byte moves the
                  {SHA}-256 leading-zero distribution (it does not), then
                  whether the inputs sharing a leading-zero count have
                  any detectable common structure (they do not).  Its
                  measurements appear here as field applications of the
                  binomial, geometric, uniform, chi-squared, Gumbel and
                  dispersion machinery}
}
